msgstr "Sichtbarkeit und Verantwortung"

#: templates/ephios_shift_coordination/template_form.html:35
msgid "Shifts"
msgstr "Schichten"

#: templates/ephios_shift_coordination/template_form.html:37
msgid "Each shift is asked for separately in the survey and staffed separately in the plan."
msgstr "Jede Schicht wird in der Umfrage einzeln abgefragt und im Dienstplan einzeln besetzt."

#: templates/ephios_shift_coordination/template_form.html:69
