#: apps.py:7 apps.py:10 preferences.py:14 signals.py:38 signals.py:44
#: templates/ephios_shift_coordination/event_info.html:5
#: templates/ephios_shift_coordination/period_detail.html:10
#: templates/ephios_shift_coordination/period_list.html:4
#: templates/ephios_shift_coordination/period_list.html:11
msgid "Shift coordination"
msgstr "Dienstplanung"

#: apps.py:12
msgid "Availability surveys and service planning for ephios"
msgstr "Verfügbarkeitsumfragen und Dienstplanung für ephios"

#: assemblies.py:108
msgid "You cannot publish events for any group."
msgstr "Du darfst für keine Gruppe Veranstaltungen veröffentlichen."

#: assemblies.py:118 forms.py:676
msgid "The assembly has to end after it starts."
msgstr "Die Versammlung muss nach ihrem Beginn enden."

#: assemblies.py:139 templates/ephios_shift_coordination/assembly_info.html:5
msgid "Assembly"
msgstr "Versammlung"

#: assemblies.py:193
msgid "This link has expired. Please open the assembly in ephios."
msgstr "Dieser Link ist abgelaufen. Bitte öffne die Versammlung in ephios."

#: assemblies.py:207
msgid "This assembly has no shift any more."
msgstr "Zu dieser Versammlung gibt es keine Schicht mehr."

#: assemblies.py:209
msgid "This assembly is over."
msgstr "Diese Versammlung ist vorbei."

#: dates.py:18
msgid "Choose a valid holiday country and region."
msgstr "Bitte ein gültiges Feiertagsland und eine Region auswählen."

#: dates.py:24
msgid "The end date must not precede the start date."
msgstr "Das Enddatum darf nicht vor dem Anfangsdatum liegen."

#: dates.py:48
#, python-format
msgid "The local time %(time)s is ambiguous or does not exist in %(zone)s."
msgstr "Die Ortszeit %(time)s ist in %(zone)s mehrdeutig oder existiert nicht."

#: drafts.py:34
msgid "No complete response for this shift"
msgstr "Keine vollständige Rückmeldung für diese Schicht"

#: drafts.py:35
msgid "Marked unavailable"
msgstr "Als nicht verfügbar markiert"

#: drafts.py:36
msgid "Required qualification missing or expired"
msgstr "Erforderliche Qualifikation fehlt oder ist abgelaufen"

#: drafts.py:37
msgid "Personal maximum exceeded"
msgstr "Persönliche Höchstzahl überschritten"

#: drafts.py:38
msgid "Weekly limit exceeded"
msgstr "Wöchentliche Höchstzahl überschritten"

#: drafts.py:39
msgid "Services on consecutive days"
msgstr "Dienste an aufeinanderfolgenden Tagen"

#: drafts.py:40
msgid "Overlapping services of the same event type"
msgstr "Überschneidende Dienste desselben Veranstaltungstyps"

#: drafts.py:41
msgid "Shift maximum exceeded"
msgstr "Höchstbesetzung der Schicht überschritten"

#: drafts.py:42
msgid "No offer to sit in on this service"
msgstr "Kein Beisitz-Angebot für diesen Dienst"

#: drafts.py:43
msgid "Too few regular people besides those sitting in"
msgstr "Zu wenige regulär Eingeteilte neben dem Beisitz"

#: drafts.py:44
msgid "Partly staffed: this service cannot take place"
msgstr "Nur teilweise besetzt: so kann der Dienst nicht stattfinden"

#: drafts.py:68
msgid "Planning is available from the open survey until publication."
msgstr "Planen kannst du ab dem Öffnen der Umfrage bis zur Veröffentlichung."

#: drafts.py:336 publication.py:152
msgid "The draft or its inputs have changed. Reload before continuing."
msgstr "Der Entwurf oder seine Eingangsdaten wurden geändert. Neu laden, bevor du fortfährst."

#: drafts.py:349 drafts.py:364
msgid "Invalid assignment selection."
msgstr "Ungültige Auswahl von Zuteilungen."

#: drafts.py:355
msgid "A selected person or shift is unavailable or lacks event access. Remove that assignment."
msgstr "Eine ausgewählte Person oder Schicht ist nicht verfügbar oder der Veranstaltungszugriff fehlt. Entferne diese Zuteilung."

#: drafts.py:360 staffing.py:380
msgid "Sitting in is switched off for this period."
msgstr "Beisitz ist für dieses Intervall nicht aktiviert."

#: drafts.py:389
msgid "Confirm the exceptions explicitly; a note may have at most 2000 characters."
msgstr "Bestätige die Ausnahmen ausdrücklich; eine Anmerkung darf höchstens 2000 Zeichen haben."

#: drafts.py:394
msgid "Confirm every current rule violation with a reason before saving."
msgstr "Bestätige vor dem Speichern jeden aktuellen Regelverstoß mit einer Begründung."

#: ephios_integration.py:17
#, python-brace-format
msgid "{name} · sitting in"
msgstr "{name} · Beisitz"

#: ephios_integration.py:111
msgid "The original event was deleted or changed. Check the native events."
msgstr "Die ursprüngliche Veranstaltung wurde gelöscht oder geändert. Bitte die Veranstaltungen in ephios prüfen."

#: ephios_integration.py:119
msgid "The event's shifts have changed. Check the native events."
msgstr "Die Schichten der Veranstaltung wurden geändert. Bitte die Veranstaltungen in ephios prüfen."

#: ephios_integration.py:137
msgid "A shift was changed or already has participations. Check the native events."
msgstr "Eine Schicht wurde geändert oder enthält bereits Teilnahmen. Bitte die Veranstaltungen in ephios prüfen."

#: ephios_integration.py:141
msgid "Event type qualifications have changed since the survey opened."
msgstr "Die Qualifikationsanforderungen des Veranstaltungstyps wurden seit Öffnung der Umfrage geändert."

#: forms.py:25
msgid "Monday"
msgstr "Montag"

#: forms.py:26
msgid "Tuesday"
msgstr "Dienstag"

#: forms.py:27
msgid "Wednesday"
msgstr "Mittwoch"

#: forms.py:28
msgid "Thursday"
msgstr "Donnerstag"

#: forms.py:29
msgid "Friday"
msgstr "Freitag"

#: forms.py:30
msgid "Saturday"
msgstr "Samstag"

#: forms.py:31
msgid "Sunday"
msgstr "Sonntag"

#: forms.py:46
msgid "Everybody staffed for a service, including anybody sitting in, is reminded this many days before it starts. Separate several values with commas, 0 means the same day. Empty means no reminder."
msgstr "Alle, die für einen Dienst eingeteilt sind, auch Beisitzende, werden so viele Tage vorher erinnert. Mehrere Werte mit Komma trennen, 0 bedeutet am selben Tag. Leer bedeutet keine Erinnerung."

#: forms.py:51
msgid "Everybody invited to an assembly is reminded this many days before it starts, whatever they answered. Separate several values with commas, 0 means the same day. Empty means no reminder."
msgstr "Alle, die zu einer Versammlung eingeladen sind, werden so viele Tage vorher erinnert, unabhängig von ihrer Antwort. Mehrere Werte mit Komma trennen, 0 bedeutet am selben Tag. Leer bedeutet keine Erinnerung."

#: forms.py:59
msgid "Suggested day for the reminder about the next planning period, counted back from the end of the one being created."
msgstr "Vorgeschlagener Tag für die Erinnerung an das nächste Planungsintervall, gerechnet vom Ende des gerade angelegten."

#: forms.py:62
msgid "Preselected weekdays for new planning periods."
msgstr "Vorauswahl der Wochentage für neue Planungsintervalle."

#: forms.py:63
msgid "Country of the holiday calendar."
msgstr "Land des Feiertagskalenders."

#: forms.py:64
msgid "Region of the holiday calendar. Without a region, holidays cannot be skipped."
msgstr "Region des Feiertagskalenders. Ohne Region können Feiertage nicht übersprungen werden."

#: forms.py:65
msgid "Preselection for new planning periods: skip public holidays."
msgstr "Vorauswahl für neue Planungsintervalle: an Feiertagen keine Dienste vorschlagen."

#: forms.py:66
msgid "Default time to answer, counted from opening a survey."
msgstr "Voreingestellte Antwortzeit, gerechnet ab dem Öffnen der Umfrage."

#: forms.py:68
msgid "Members without a complete answer are reminded this many days before the deadline. Separate several values with commas, for example 3, 1. Empty means no reminder."
msgstr "Mitglieder ohne vollständige Antwort werden so viele Tage vor Fristende erinnert. Mehrere Werte mit Komma trennen, zum Beispiel 3, 1. Leer bedeutet keine Erinnerung."

#: forms.py:72
msgid "Most shifts one person takes per calendar week (Monday to Sunday) within one event type."
msgstr "Höchstzahl der Schichten pro Person und Kalenderwoche (Montag bis Sonntag) innerhalb eines Veranstaltungstyps."

#: forms.py:74
msgid "Keep the day after a service free for that person."
msgstr "Den Tag nach einem Dienst für diese Person freihalten."

#: forms.py:76
msgid "Time budget for one automatic proposal. A higher value can improve a proposal, but the request takes longer; application and proxy timeouts have to be above it."
msgstr "Rechenzeit für einen automatischen Vorschlag. Ein höherer Wert kann den Vorschlag verbessern, verlängert aber die Wartezeit; die Zeitlimits von Anwendung und Proxy müssen darüber liegen."

#: forms.py:80
msgid "Preselection for new planning periods: members may offer to sit in on a service. Sitting in needs no qualification, counts as staffing and earns no working hours."
msgstr "Vorauswahl für neue Planungsintervalle: Mitglieder können anbieten, bei einem Dienst beizusitzen. Beisitz braucht keine Qualifikation, zählt zur Besetzung und bringt keine Arbeitsstunden."

#: forms.py:84
msgid "Regularly staffed people a shift needs at least once somebody sits in. This prevents shifts that are staffed by people sitting in only."
msgstr "So viele regulär eingeteilte Personen braucht eine Schicht mindestens, sobald jemand beisitzt. Das verhindert Schichten, die nur mit Beisitz besetzt sind."

#: forms.py:90
msgid "Services are suggested for these weekdays. You pick the single dates below."
msgstr "An diesen Wochentagen werden Dienste vorgeschlagen. Die einzelnen Termine wählst du darunter aus."

#: forms.py:91
msgid "Skip the public holidays of the configured region."
msgstr "Feiertage der eingerichteten Region überspringen."

#: forms.py:92
msgid "Used for the response deadline suggested when you open the survey."
msgstr "Wird für die vorgeschlagene Rückmeldefrist beim Öffnen der Umfrage verwendet."

#: forms.py:94
msgid "Suggested reminders when you open the survey. Separate several values with commas."
msgstr "Vorschlag für die Erinnerungen beim Öffnen der Umfrage. Mehrere Werte mit Komma trennen."

#: forms.py:96
msgid "Most shifts per person and calendar week (Monday to Sunday)."
msgstr "Höchstzahl der Schichten pro Person und Kalenderwoche (Montag bis Sonntag)."

#: forms.py:97
msgid "Nobody is planned on two days in a row."
msgstr "Niemand wird an zwei aufeinanderfolgenden Tagen eingeplant."

#: forms.py:99
msgid "Members may offer to sit in on a service of this period: no qualification required, counted as staffing, no working hours."
msgstr "Mitglieder können anbieten, bei einem Dienst dieses Intervalls beizusitzen: ohne Qualifikation, zählt zur Besetzung, ohne Arbeitsstunden."

#: forms.py:110
msgid "Enter whole numbers separated by commas."
msgstr "Bitte ganze Zahlen mit Kommas getrennt eingeben."

#: forms.py:116 models.py:43
msgid "Weekdays"
msgstr "Wochentage"

#: forms.py:119 forms.py:422
msgid "Reminders in days before the deadline"
msgstr "Erinnerungen in Tagen vor Fristende"

#: forms.py:122 models.py:44
msgid "Holiday country"
msgstr "Feiertagsland"

#: forms.py:125 models.py:45
msgid "Holiday region"
msgstr "Feiertagsregion"

#: forms.py:135
msgid "Select a region"
msgstr "Region auswählen"

#: forms.py:150
msgid "Groups allowed to manage planning"
msgstr "Gruppen mit Planungsberechtigung"

#: forms.py:154
msgid "Members of these groups create planning periods, open surveys and publish plans. In ephios they also need the rights to create events and to publish them for the template's groups."
msgstr "Mitglieder dieser Gruppen legen Planungsintervalle an, öffnen Umfragen und veröffentlichen Dienstpläne. In ephios brauchen sie zusätzlich das Recht, Veranstaltungen anzulegen und für die Gruppen der Vorlage zu veröffentlichen."

#: forms.py:160
msgid "Remind about services this many days before"
msgstr "An Dienste erinnern, so viele Tage vorher"

#: forms.py:163
msgid "Remind about assemblies this many days before"
msgstr "An Versammlungen erinnern, so viele Tage vorher"

#: forms.py:167
msgid "Event types in the public duty information"
msgstr "Veranstaltungstypen in der öffentlichen Dienstauskunft"

#: forms.py:171
msgid "Only shifts of these types are counted, and only while they are staffed."
msgstr "Gezählt werden nur Schichten dieser Typen, und nur solange sie besetzt sind."

#: forms.py:192
msgid "Everybody but administrators stops seeing the working hour pages, their own as well as the overview, and the links to them disappear."
msgstr "Außer Administratorinnen und Administratoren sieht niemand mehr die Arbeitszeitseiten, weder die eigene noch die Übersicht, und die Links dorthin verschwinden."

#: forms.py:196
msgid "Answers three questions without a login: whether a duty runs now, when the next one starts and which weekdays of this week carry one. No personal data is shared."
msgstr "Beantwortet ohne Anmeldung drei Fragen: ob gerade ein Dienst läuft, wann der nächste beginnt und an welchen Wochentagen dieser Woche einer stattfindet. Personenbezogene Daten werden nicht herausgegeben."

#: forms.py:234
msgid "Title of every event created from this template."
msgstr "Titel jeder Veranstaltung, die aus dieser Vorlage entsteht."

#: forms.py:235
msgid "Shown on the event page in ephios."
msgstr "Wird auf der Veranstaltungsseite in ephios angezeigt."

#: forms.py:237
msgid "Weekly limits, overlaps and consecutive days only count services of this type."
msgstr "Wochenlimit, Überschneidungen und Folgetage zählen nur Dienste dieses Typs."

#: forms.py:239
msgid "These groups see the services and are invited to the survey."
msgstr "Diese Gruppen sehen die Dienste und werden zur Umfrage eingeladen."

#: forms.py:241
msgid "May edit the created events and receive messages about missing staff. Coordinators need this to plan the period."
msgstr "Dürfen die erzeugten Veranstaltungen bearbeiten und werden über fehlende Besetzung informiert. Die Koordination braucht dieses Recht für die Planung."

#: forms.py:244
msgid "Additional responsible people besides the groups."
msgstr "Zusätzliche verantwortliche Personen neben den Gruppen."

#: forms.py:266
msgid "Short name, for example phone or early shift."
msgstr "Kurzer Name, zum Beispiel Telefon oder Frühdienst."

#: forms.py:267
msgid "When people meet, at the latest at the start."
msgstr "Wann sich alle treffen, spätestens zum Beginn."

#: forms.py:268
msgid "Choose the next day for shifts that run past midnight."
msgstr "Für Schichten über Mitternacht den Folgetag wählen."

#: forms.py:269
msgid "Automatic planning staffs exactly this many people, or nobody."
msgstr "Die automatische Planung besetzt genau so viele Personen – oder niemanden."

#: forms.py:270
msgid "Empty means no limit. More people only through a manual exception."
msgstr "Leer bedeutet unbegrenzt. Mehr Personen nur über eine manuelle Ausnahme."

#: forms.py:271
msgid "Only members holding all of these are asked for this shift."
msgstr "Nur Mitglieder mit all diesen Qualifikationen werden für diese Schicht gefragt."

#: forms.py:284
msgid "Each shift must belong to this template and appear only once."
msgstr "Jede Schicht muss zu dieser Vorlage gehören und darf nur einmal vorkommen."

#: forms.py:304 templates/ephios_shift_coordination/template_form.html:6
msgid "Service template"
msgstr "Dienstvorlage"

#: forms.py:307
msgid "Sets title, location, visibility and the shifts of every service in this period."
msgstr "Legt Titel, Ort, Sichtbarkeit und die Schichten jedes Dienstes in diesem Intervall fest."

#: forms.py:311
msgid "First day"
msgstr "Erster Tag"

#: forms.py:314
msgid "Last day"
msgstr "Letzter Tag"

#: forms.py:318
msgid "Remind me to plan the next period"
msgstr "An das nächste Planungsintervall erinnern"

#: forms.py:320
msgid "You get one message on that day, with a link to a new planning period."
msgstr "Du bekommst an diesem Tag eine Nachricht mit einem Link zu einem neuen Planungsintervall."

#: forms.py:323
msgid "Remind me on"
msgstr "Erinnern am"

#: forms.py:341
msgid "Configure a holiday region in the planning settings to use this."
msgstr "Dafür in den Planungseinstellungen eine Feiertagsregion einrichten."

#: forms.py:369
msgid "The last day must not precede the first day."
msgstr "Der letzte Tag darf nicht vor dem ersten Tag liegen."

#: forms.py:373
msgid "Choose the day of the reminder."
msgstr "Bitte den Tag der Erinnerung auswählen."

#: forms.py:375
msgid "The reminder has to be in the future."
msgstr "Die Erinnerung muss in der Zukunft liegen."

#: forms.py:379
msgid "A reminder after the period has ended comes too late to be useful."
msgstr "Eine Erinnerung nach dem Ende des Intervalls kommt zu spät."

#: forms.py:398
msgid "Invalid selected date."
msgstr "Ungültiges ausgewähltes Datum."

#: forms.py:407 services.py:106
msgid "Select distinct dates within the period."
msgstr "Bitte unterschiedliche Termine innerhalb des Intervalls auswählen."

#: forms.py:414
msgid "Response deadline"
msgstr "Rückmeldefrist"

#: forms.py:417
msgid "Until then members can answer and change their answer. It has to be before the first shift starts."
msgstr "Bis dahin können Mitglieder antworten und ihre Antwort ändern. Die Frist muss vor dem Beginn der ersten Schicht liegen."

#: forms.py:425
msgid "Members without a complete answer get a reminder. Separate several values with commas, for example 3, 1. Empty means no reminder."
msgstr "Mitglieder ohne vollständige Antwort erhalten eine Erinnerung. Mehrere Werte mit Komma trennen, zum Beispiel 3, 1. Leer bedeutet keine Erinnerung."

#: forms.py:430
msgid "Recommended shifts per person"
msgstr "Empfohlene Schichten pro Person"

#: forms.py:433
msgid "Shown to members as a suggestion for their personal maximum."
msgstr "Wird den Mitgliedern als Vorschlag für ihre persönliche Höchstzahl angezeigt."

#: forms.py:446
msgid "Close the survey now. Answers become read-only, planning continues."
msgstr "Umfrage jetzt schließen. Antworten sind dann nur noch lesbar, die Planung geht weiter."

#: forms.py:453
msgid "Your personal maximum"
msgstr "Deine persönliche Höchstzahl"

#: forms.py:457
msgid "How many shifts may we assign to you at most in this period? Enter 0 if you cannot take a shift this time."
msgstr "Wie viele Schichten dürfen wir dir in diesem Zeitraum höchstens zuteilen? Trage 0 ein, wenn du diesmal keine Schicht übernehmen kannst."

#: forms.py:462
msgid "Notes for the coordinators"
msgstr "Anmerkungen für die Koordination"

#: forms.py:467
msgid "Optional, for example holidays or who you would like to work with. Only coordinators read this."
msgstr "Optional, zum Beispiel Urlaub oder mit wem du gern zusammen Dienst machst. Das liest nur die Koordination."

#: forms.py:514
#, python-brace-format
msgid "{shift} on {date}"
msgstr "{shift} am {date}"

#: forms.py:521
msgid "You currently do not meet the requirements for this shift."
msgstr "Du erfüllst die Anforderungen dieser Schicht aktuell nicht."

#: forms.py:540
#, python-brace-format
msgid "Sit in on the service on {date}"
msgstr "Beim Dienst am {date} beisitzen"

#: forms.py:582
msgid "Rate exactly the originally offered shifts."
msgstr "Bitte genau die ursprünglich angebotenen Schichten bewerten."

#: forms.py:596
msgid "Confirm every recorded exception once more"
msgstr "Bestätige jede dokumentierte Ausnahme noch einmal"

#: forms.py:601
msgid "I publish although some shifts are missing people."
msgstr "Ich veröffentliche, obwohl in einigen Schichten Personen fehlen."

#: forms.py:605
msgid "I checked this plan and want to publish it. Everybody staffed gets a message."
msgstr "Ich habe den Dienstplan geprüft und möchte ihn veröffentlichen. Alle Eingeteilten bekommen eine Nachricht."

#: forms.py:621
msgid "Sign up"
msgstr "Eintragen"

#: forms.py:621 templates/ephios_shift_coordination/event_info.html:60
msgid "Sit in"
msgstr "Beisitzen"

#: forms.py:621
msgid "Sign off"
msgstr "Austragen"

#: forms.py:630 templates/ephios_shift_coordination/assembly_list.html:26
msgid "Kind of assembly"
msgstr "Art der Versammlung"

#: forms.py:633
msgid "Who is invited and who is responsible comes from this kind."
msgstr "Wer eingeladen wird und wer verantwortlich ist, kommt aus dieser Art."

#: forms.py:635 models.py:123
msgid "Title"
msgstr "Titel"

#: forms.py:636 models.py:125
msgid "Location"
msgstr "Ort"

#: forms.py:638 models.py:124
msgid "Description"
msgstr "Beschreibung"

#: forms.py:641
msgid "Date"
msgstr "Datum"

#: forms.py:644
msgid "Start"
msgstr "Beginn"

#: forms.py:647
msgid "End"
msgstr "Ende"

#: forms.py:650 models.py:411
#: templates/ephios_shift_coordination/assembly_info.html:41
#: templates/ephios_shift_coordination/assembly_respond.html:75
msgid "Agenda"
msgstr "Tagesordnung"

#: forms.py:654
msgid "One item per line. It is shown at the assembly and sent with the invitation."
msgstr "Ein Punkt pro Zeile. Sie wird bei der Versammlung gezeigt und mit der Einladung verschickt."

#: forms.py:657
msgid "Call quietly, send the invitation later"
msgstr "Still einberufen, Einladung später verschicken"

#: forms.py:659
msgid "Nobody is notified now. You can send the invitation from the assembly page."
msgstr "Jetzt wird niemand benachrichtigt. Du kannst die Einladung später auf der Seite der Versammlung verschicken."

#: forms.py:678
msgid "An assembly has to start in the future."
msgstr "Eine Versammlung muss in der Zukunft beginnen."

#: forms.py:699
msgid "Assembly minutes as PDF"
msgstr "Versammlungsprotokoll als PDF"

#: forms.py:709
#, python-format
msgid "The file is too large. There are only %(quota)s available."
msgstr "Die Datei ist zu groß. Es sind nur noch %(quota)s frei."

#: minutes.py:27
msgid "assembly-minutes"
msgstr "Versammlungsprotokoll"

#: models.py:46
msgid "Exclude holidays"
msgstr "Feiertage ausschließen"

#: models.py:48
msgid "Response period in days"
msgstr "Antwortfrist in Tagen"

#: models.py:51
msgid "Reminder days before deadline"
msgstr "Erinnerungen in Tagen vor Fristende"

#: models.py:53
msgid "Weekly limit"
msgstr "Wochenlimit"

#: models.py:54
msgid "Keep the next day free"
msgstr "Folgetag freihalten"

#: models.py:56
msgid "Calculation budget in seconds"
msgstr "Rechenbudget in Sekunden"

#: models.py:58
msgid "Allow observers"
msgstr "Beisitz erlauben"

#: models.py:60
msgid "Regular people per shift with observers"
msgstr "Reguläre Personen je Schicht mit Beisitz"

#: models.py:65
msgid "Service reminders in days before"
msgstr "Diensterinnerungen in Tagen vorher"

#: models.py:67
msgid "Service reminder time"
msgstr "Uhrzeit der Diensterinnerung"

#: models.py:69
msgid "Assembly reminders in days before"
msgstr "Versammlungserinnerungen in Tagen vorher"

#: models.py:71
msgid "Assembly reminder time"
msgstr "Uhrzeit der Versammlungserinnerung"

#: models.py:73
msgid "Remind about the next period this many weeks before the end"
msgstr "An das nächste Intervall erinnern, so viele Wochen vor dem Ende"

#: models.py:77
msgid "Hide the working hours"
msgstr "Arbeitszeiten verbergen"

#: models.py:78 templates/ephios_shift_coordination/settings.html:78
msgid "Public duty information"
msgstr "Öffentliche Dienstauskunft"

#: models.py:80
msgid "Event types in the public information"
msgstr "Veranstaltungstypen der öffentlichen Auskunft"

#: models.py:96
msgid "Choose distinct weekdays."
msgstr "Bitte unterschiedliche Wochentage auswählen."

#: models.py:102
msgid "Enter distinct positive reminder offsets."
msgstr "Bitte unterschiedliche positive Erinnerungsabstände eingeben."

#: models.py:111
msgid "Enter distinct reminder offsets of zero or more."
msgstr "Bitte unterschiedliche Erinnerungsabstände ab null eingeben."

#: models.py:126
msgid "Event type"
msgstr "Veranstaltungstyp"

#: models.py:127
msgid "Visible for"
msgstr "Sichtbar für"

#: models.py:132
msgid "Responsible groups"
msgstr "Verantwortliche Gruppen"

#: models.py:135
msgid "Responsible persons"
msgstr "Verantwortliche Personen"

#: models.py:145
msgid "Label"
msgstr "Bezeichnung"

#: models.py:146
msgid "Meeting time"
msgstr "Treffzeit"

#: models.py:147
msgid "Start time"
msgstr "Beginn"

#: models.py:148
msgid "End time"
msgstr "Endzeit"

#: models.py:150
msgid "End day"
msgstr "Endtag"

#: models.py:150
msgid "Same day"
msgstr "Derselbe Tag"

#: models.py:150
msgid "Next day"
msgstr "Folgetag"

#: models.py:153
msgid "Minimum staffing"
msgstr "Mindestbesetzung"

#: models.py:155
msgid "Maximum staffing"
msgstr "Höchstbesetzung"

#: models.py:157
msgid "Qualifications"
msgstr "Qualifikationen"

#: models.py:180
msgid "Maximum staffing must be at least the positive minimum."
msgstr "Die Höchstbesetzung muss mindestens der positiven Mindestbesetzung entsprechen."

